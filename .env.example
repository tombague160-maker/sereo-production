# Serveur
# NODE_ENV n'est pas lue par Sereo mais par Express : production masque le
# detail des erreurs. L'image Docker la pose deja.
NODE_ENV=production
PORT=3000
SEREO_HOST=0.0.0.0
# Ancien nom de SEREO_HOST, lu seulement si SEREO_HOST est vide.
# HOST=

# Heure du conteneur. L'image ne pose PAS TZ : le processus tourne en UTC, et
# c'est le reglage verifie par les tests. Les jours et heures du metier (jour
# de livraison, planning de nuit a 3 h) sont calcules a Paris par le code
# (lib/jour-paris.js) ; seuls les journaux (docker logs) et les noms des
# sauvegardes (db-2026-09-25T14-00-00-000Z...) sont en UTC : 1 h de moins
# l'hiver, 2 h l'ete. Laisser vide.
# TZ=

# Version affichee (pied de page, /api/version). Posee par sereo-updater
# depuis l'etiquette git (git describe). Vide : le fichier VERSION a la racine
# s'il existe, sinon package.json.
# SEREO_APP_VERSION=
# 1 : /api/version n'appelle pas l'API GitHub pour les notes de version (tests
# et serveurs d'essai : 60 appels par heure et par adresse sans compte).
# SEREO_SKIP_RELEASE_FETCH=

# Persistance
# Mode par defaut recommande. Utilise une base SQLite partagee cote serveur.
SEREO_STORAGE=sqlite

# En production, placer ce fichier sur un volume disque persistant.
SEREO_SQLITE_PATH=/data/sereo.sqlite
# Ancien nom de SEREO_SQLITE_PATH, lu seulement si SEREO_SQLITE_PATH est vide.
# SQLITE_PATH=

# Chemin de l'ancien JSON, utilise uniquement comme source de migration initiale.
SEREO_DB_PATH=./data/db.json

# Fichiers temporaires et sauvegardes.
SEREO_UPLOAD_DIR=/tmp/sereo-uploads
SEREO_BACKUP_DIR=/data/backups
# Copie brute de chaque fichier Excel importe (retelechargement, audit). Par
# defaut : imports-archives/, a cote de la base (donc sur le volume persistant).
# SEREO_IMPORTS_ARCHIVES_DIR=/data/imports-archives

# Second dossier de sauvegarde, optionnel (garde-fous du 25/09). Un AUTRE disque,
# ou un partage monte dans le conteneur : chaque sauvegarde y est aussi copiee,
# relue (meme empreinte que l'originale) et gardee selon la meme regle que
# SEREO_BACKUP_DIR (30 dernieres, une par jour 30 jours, une par semaine 8 semaines,
# celles d'avant une purge des bons toujours). Vide : les sauvegardes ne sont que
# sur le disque de la base. Le dossier doit porter un fichier vide nomme
# sereo-second-dossier (a poser une fois, sur l'autre disque) : s'il manque --
# disque demonte --, rien n'y est copie. Une copie qui echoue ne bloque rien : la
# carte « Sauvegardes » de Parametres le dit. Voir DEPLOYMENT.md, « Sauvegardes ».
# SEREO_BACKUP_COPY_DIR=/sauvegardes-copie

# Conservation des tournees terminees, en mois (12 par defaut). Chaque jour, les
# plus anciennes sont supprimees avec leurs arrets et leur trace, APRES une
# sauvegarde forcee (db-...-avant-purge.sqlite.gz) ; les commandes et le chiffre
# d'affaires restent. 0 coupe la purge.
# SEREO_PURGE_TOURNEES_MOIS=12

# Export complet de la base. Laisser desactive sauf besoin d'administration locale.
# Meme a 1, reserve a l'administration (GET /api/db, garde-fous du 25/09).
SEREO_ENABLE_DB_EXPORT=0

# Protection d'acces.
# Renseigner les deux valeurs avant une publication en ligne.
# Laisser vide en developpement local si vous ne voulez pas de demande de mot de passe.
# Au moins 12 caracteres pour SEREO_AUTH_PASSWORD : plus court, le serveur
# demarre quand meme, mais le journal le signale et l'administration voit un
# bandeau d'alerte (garde-fous du 25/09).
SEREO_AUTH_USER=
SEREO_AUTH_PASSWORD=
SEREO_AUTH_REALM=Sereo

# Secret utilise pour signer le cookie de session HMAC.
# Le password courant est TOUJOURS integre dans le secret final, donc un changement
# de password invalide automatiquement toutes les sessions existantes (rotation).
# Laisser vide : le serveur tire un secret aleatoire, l'ecrit dans le dossier de
# donnees (fichier session-secret, a cote de la base, hors du depot) et le relit
# a chaque demarrage -- les sessions survivent aux redemarrages. Sinon definir
# une chaine longue (prioritaire sur le fichier).
SEREO_AUTH_SESSION_SECRET=

# Rate limit sur /login (anti brute-force).
# Defauts : 5 tentatives ratees / 15 minutes -> lockout 15 secondes.
# Affichage cote utilisateur : compteur de tentatives restantes + countdown live.
SEREO_AUTH_MAX_ATTEMPTS=5
SEREO_AUTH_RATE_WINDOW_MS=900000
SEREO_AUTH_LOCKOUT_MS=15000

# Et par compte, quelle que soit l'adresse (garde-fous du 25/09) : 20 echecs sur
# un meme identifiant dans l'heure bloquent CET identifiant 15 minutes (formulaire
# et authentification Basic) ; les autres comptes ne sont pas touches, une
# connexion reussie remet le compteur a zero. Un appareil qui a deja ouvert ce
# compte (cookie « appareil connu ») n'est ni bloque ni compte : la limite ne
# vise que les appareils inconnus. Defauts ci-dessous.
# SEREO_AUTH_MAX_ATTEMPTS_COMPTE=20
# SEREO_AUTH_RATE_WINDOW_COMPTE_MS=3600000
# SEREO_AUTH_LOCKOUT_COMPTE_MS=900000

# Separation des acces par role (onglets visibles selon le role du compte).
# Desactivee par decision du 26/08 : tout le monde voit tous les onglets.
# 1 : l'active. Elle ne pilote que la NAVIGATION ; les droits reels sont
# appliques par le serveur, route par route.
# SEREO_SEPARATION_ROLES=

# --- Geocodage des adresses (V8 phase 2) ------------------------------------
# Le serveur geocode les adresses clients via la Base Adresse Nationale
# (gratuite, sans cle). L'appel est cote SERVEUR : la CSP declare
# connect-src 'self', le navigateur ne peut joindre aucune API externe.

# Declenchement automatique apres un import de ventes. Mettre a 0 pour ne
# geocoder que sur demande explicite (POST /api/geocodage/lancer), qui reste
# disponible dans tous les cas.
SEREO_GEOCODAGE_AUTO=1

# Point d'acces du geocodeur. A ne changer que pour pointer une instance
# auto-hebergee, ou un faux serveur en test.
# SEREO_GEOCODER_URL=https://api-adresse.data.gouv.fr/search/

# Intervalle entre deux appels, en millisecondes. Un import se geocode en tache
# de fond : rien ne presse, et cette cadence evite de passer pour un robot.
# SEREO_GEOCODER_INTERVALLE_MS=120

# Delai maximal d'un appel, en millisecondes.
# SEREO_GEOCODER_TIMEOUT_MS=8000

# Nombre maximal d'adresses traitees par lancement. Garde-fou contre une base
# anormalement grosse qui partirait en boucle plusieurs heures.
# SEREO_GEOCODER_MAX_PAR_LOT=300

# Contact inscrit dans l'en-tete User-Agent envoye au geocodeur (politesse
# envers le service). Par defaut : le depot public du projet. Jamais une
# adresse personnelle.
# SEREO_CONTACT_URL=https://github.com/tombague160-maker/sereo-production

# Moteur de trajet OSRM (service public par défaut, sans SLA).
# Pour un usage métier soutenu : instance dédiée / prestataire compatible OSRM.
# Une instance locale se branche telle quelle, par exemple http://127.0.0.1:5000
SEREO_ROUTING_URL=https://router.project-osrm.org

# Repli si SEREO_ROUTING_URL ne répond pas (réseau, délai, 5xx) : pendant 60 s,
# le calcul part ici, et le journal l'écrit. Les coordonnées de la tournée
# sortent alors chez ce tiers. Par défaut : le serveur public. Vide : pas de repli.
# SEREO_ROUTING_REPLI_URL=https://router.project-osrm.org

# Carte OSRM LOCALE, integree a l'image Docker (23/09). Rien a regler : au
# premier demarrage, Sereo choisit la zone selon la memoire et le disque,
# telecharge la carte (Geofabrik), la prepare en priorite basse et calcule
# ensuite les tournees chez lui (http://127.0.0.1:5000, dans le conteneur).
# Mise a jour chaque mois, la nuit (3 h). Tant qu'elle n'est pas prete, ou si
# elle tombe, le calcul passe par SEREO_ROUTING_URL puis son repli (ci-dessus).
# Hors de l'image Docker (binaires OSRM absents), rien ne se passe.
# 0 : coupe tout (ni telechargement, ni preparation, ni processus).
# SEREO_OSRM_LOCAL=1
# Force la zone : france, voisins (Bourgogne-Franche-Comte + Grand Est,
# Auvergne-Rhone-Alpes, Centre-Val de Loire, Ile-de-France, Suisse), region
# (Bourgogne-Franche-Comte), aucune, ou des chemins Geofabrik separes par des
# virgules (ex. europe/monaco). Par defaut : selon la memoire et le disque.
# SEREO_OSRM_ZONE=
# Dossier des cartes (par defaut : a cote de la base SQLite, /app/data/osrm).
# SEREO_OSRM_DIR=/app/data/osrm
# Port local d'osrm-routed dans le conteneur.
# SEREO_OSRM_PORT=5000

# Fond de carte (tuiles). UN seul endroit : la page le recoit par /api/carte/fond
# et la CSP (img-src) suit le meme hote. Par defaut : OpenStreetMap, dont la
# politique d'usage demande un fournisseur dedie pour un usage commercial soutenu.
# Gabarit https avec {z}, {x}, {y} ({s} permis dans l'hote). Une URL invalide
# retombe sur OpenStreetMap. L'attribution (HTML) est celle qu'exige le fournisseur.
# SEREO_TUILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# SEREO_TUILES_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">les contributeurs d'OpenStreetMap</a>
# SEREO_TUILES_ZOOM_MAX=19
