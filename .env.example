# Serveur
NODE_ENV=production
PORT=3000
SEREO_HOST=0.0.0.0

# Persistance
# Mode par defaut recommande. Utilise une base SQLite partagee cote serveur.
SEREO_STORAGE=sqlite

# En production, placer ce fichier sur un volume disque persistant.
SEREO_SQLITE_PATH=/data/sereo.sqlite

# Chemin de l'ancien JSON, utilise uniquement comme source de migration initiale.
SEREO_DB_PATH=./data/db.json

# Fichiers temporaires et sauvegardes.
SEREO_UPLOAD_DIR=/tmp/sereo-uploads
SEREO_BACKUP_DIR=/data/backups

# Export complet de la base. Laisser desactive sauf besoin d'administration locale.
SEREO_ENABLE_DB_EXPORT=0

# Protection d'acces.
# Renseigner les deux valeurs avant une publication en ligne.
# Laisser vide en developpement local si vous ne voulez pas de demande de mot de passe.
SEREO_AUTH_USER=
SEREO_AUTH_PASSWORD=
SEREO_AUTH_REALM=Sereo

# Secret utilise pour signer le cookie de session HMAC.
# Le password courant est TOUJOURS integre dans le secret final, donc un changement
# de password invalide automatiquement toutes les sessions existantes (rotation).
# Laisser vide pour utiliser AUTH_REALM comme base, sinon definir une chaine longue.
SEREO_AUTH_SESSION_SECRET=

# Rate limit sur /login (anti brute-force).
# Defauts : 5 tentatives ratees / 15 minutes -> lockout 15 secondes.
# Affichage cote utilisateur : compteur de tentatives restantes + countdown live.
SEREO_AUTH_MAX_ATTEMPTS=5
SEREO_AUTH_RATE_WINDOW_MS=900000
SEREO_AUTH_LOCKOUT_MS=15000

# --- Geocodage des adresses (V8 phase 2) ------------------------------------
# Le serveur geocode les adresses clients via la Base Adresse Nationale
# (gratuite, sans cle). L'appel est cote SERVEUR : la CSP declare
# connect-src 'self', le navigateur ne peut joindre aucune API externe.

# Declenchement automatique apres un import de ventes. Mettre a 0 pour ne
# geocoder que sur demande explicite (POST /api/geocodage/lancer), qui reste
# disponible dans tous les cas.
SEREO_GEOCODAGE_AUTO=1

# Point d'acces du geocodeur. A ne changer que pour pointer une instance
# auto-hebergee, ou un faux serveur en test.
# SEREO_GEOCODER_URL=https://api-adresse.data.gouv.fr/search/

# Intervalle entre deux appels, en millisecondes. Un import se geocode en tache
# de fond : rien ne presse, et cette cadence evite de passer pour un robot.
# SEREO_GEOCODER_INTERVALLE_MS=120

# Delai maximal d'un appel, en millisecondes.
# SEREO_GEOCODER_TIMEOUT_MS=8000

# Nombre maximal d'adresses traitees par lancement. Garde-fou contre une base
# anormalement grosse qui partirait en boucle plusieurs heures.
# SEREO_GEOCODER_MAX_PAR_LOT=300
