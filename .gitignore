node_modules/

audit/

# data/ : TOUT est ignore, et les exceptions sont explicites.
#
# Ce bloc listait des fichiers precis (db.json, *.sqlite, backups/*). Le dossier
# contient aussi, non suivis, des exports metier reels -- stock.xlsx,
# ventes.xlsx, des journaux, des captures. Un seul `git add -A` les mettait en
# index, et ce depot est PUBLIC. C'est arrive le 18/09 : 17 fichiers stages,
# dont les deux classeurs clients, rattrapes avant le commit.
#
# Ignorer le DOSSIER et ouvrir des exceptions nommees inverse le defaut : un
# fichier neuf depose la est invisible a git jusqu'a ce que quelqu'un decide
# explicitement le contraire. Le sens de la garde compte plus que sa longueur.
data/*
!data/backups/
data/backups/*
!data/backups/.gitkeep

.env
!.env.example

imports/*
!imports/.gitkeep

uploads/*
!uploads/.gitkeep

exports/*
!exports/.gitkeep

# Playwright (Sprint 3 audit v1.13.2)
playwright-report/
test-results/
playwright/.cache/

# Captures d'ecran d'audit UI produites par data/capture.js.
# Plusieurs dizaines de Mo par serie : utiles en local, jamais dans le depot.
data/shots*/

# Canevas de maquettes assemble : ~2 Mo d'editeur embarque, reconstruit a la
# demande depuis les .dc.html par le script de seed. Ce sont les sources qui
# sont versionnees, pas le produit.
design/maquettes-v8/*.html
!design/maquettes-v8/*.dc.html

# Captures PNG des planches, produites par design/maquettes-v8/capturer.js.
# Produit derive : se regenere en une commande, jamais dans le depot.
design/maquettes-v8/captures/
